PORT=3000
CLIENT_URL=http://localhost:5173
CLERK_SECRET_KEY=sk_test_replace_me
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/fund_portal
# Set true for hosted PostgreSQL providers that require SSL.
DATABASE_SSL=false

# Development-only fixture seed: use an actual Clerk test-user ID and temporarily set SEED_DEMO_DATA=true.
DEMO_INVESTOR_CLERK_USER_ID=
# SEED_DEMO_DATA=true

# Integration mode defaults to sandbox. Production requires separate credentials and approved workflows.
INTEGRATION_MODE=sandbox
KYC_PROVIDER=persona
ESIGN_PROVIDER=docusign

# Persona sandbox and production credentials are deliberately separate.
PERSONA_API_BASE_URL=https://api.withpersona.com/api/v1
PERSONA_API_VERSION=2026-09-29
PERSONA_SANDBOX_API_KEY=replace_with_sandbox_api_key
PERSONA_SANDBOX_ENVIRONMENT_ID=env_sandbox_replace_me
PERSONA_PRODUCTION_API_KEY=
PERSONA_PRODUCTION_ENVIRONMENT_ID=
PERSONA_INQUIRY_TEMPLATE_ID=itmpl_replace_with_approved_template
PERSONA_WEBHOOK_SECRET=replace_with_persona_webhook_signing_secret

# DocuSign JWT credentials. Sandbox must use demo account credentials and an approved sandbox template.
DOCUSIGN_OAUTH_BASE_URL=https://account-d.docusign.com
DOCUSIGN_INTEGRATION_KEY=replace_me
DOCUSIGN_USER_ID=replace_me
DOCUSIGN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----"
DOCUSIGN_TEMPLATE_ID=replace_with_approved_template_id
DOCUSIGN_TEMPLATE_ROLE_NAME=Investor
DOCUSIGN_AGREEMENT_VERSION=org-approved-version-id
DOCUSIGN_CONNECT_HMAC_KEY=replace_with_connect_hmac_key
